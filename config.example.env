# 复制为 config.env 后填写（权限 600）
# 浏览器登录密码（用户名随便填）
NX_PASSWORD=改成你自己的强密码
# 保守系数：0.85 风险厌恶 / 1.0 不加保守
NX_CONSERVATIVE=0.85
# 告警阈值：仓位变动多少成才提醒（避免天天手痒）
POS_DELTA_ALERT=1.0
# 数据陈旧超过几天告警
STALE_DAYS=3
# 抓取异常项达到几个才告警
FETCH_FAIL_ALERT=2
# —— 告警通道（都不填 = 只写 logs/alert.log）——
# Server酱 SendKey：https://sct.ftqq.com/
# SERVERCHAN_KEY=xxx
# 企业微信机器人
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 邮件
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=xxx@qq.com
# SMTP_PASS=授权码
# ALERT_TO=收件人@xx.com
